# Merge these keys into your EXISTING .env manually. Never overwrite it blindly.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Fill locally. URI-encode special characters in the database password.
DATABASE_URL=
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
TRUST_PROXY=none
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
# Separate PostgreSQL database/role, name ending in _test. Used ONLY by npm test.
TEST_DATABASE_URL=

# Optional Web Push: configure all three or leave all empty. Private key is server-only.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# Магазин этапа 14: новых обязательных настроек и секретов нет.
# Фото хранятся в PostgreSQL и входят в штатный backup БД.
