{
  "name": "ideal-club",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "owner:create": "node tools/create-owner.mjs",
    "password:reset": "node tools/reset-password.mjs",
    "user:manage": "node tools/manage-user.mjs",
    "test": "node tools/run-tests.mjs",
    "test:unit": "node --test tests/policy.test.js tests/schedule-dates.test.js",
    "css:auth": "sass --no-source-map site/sass/auth.scss site/css/auth.css"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "sass": "1.106.1",
    "supertest": "7.3.1"
  }
}
