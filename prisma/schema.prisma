generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  TRAINER
}
model User {
  id String @id @default(uuid()) @db.Uuid
  login String @unique @db.VarChar(64)
  displayName String @db.VarChar(100)
  passwordHash String
  role Role
  active Boolean @default(true)
  authVersion Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  trainerProfile TrainerProfile?
  crmEvents CrmEvent[]
  crmOperations CrmOperation[]
  sessions AuthSession[]
  audit AuditEvent[]
  lessonsCreated Lesson[] @relation("LessonCreatedBy")
  bookingsCreated LessonBooking[] @relation("BookingCreatedBy")
  visitsRecorded Visit[] @relation("VisitRecordedBy")
  visitsReversed Visit[] @relation("VisitReversedBy")
  pushSubscriptions PushSubscription[]
  pushDeliveries PushDelivery[]
  shopOrderEvents ShopOrderEvent[]
  scheduleEvents ScheduleEvent[]
}
model AuthSession {
  sid String @id @db.VarChar(128)
  sess Json @db.Json
  expire DateTime @db.Timestamptz(3)
  absoluteAt DateTime @db.Timestamptz(3)
  userId String? @db.Uuid
  authVersion Int?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expire])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String @db.VarChar(64)
  targetId String? @db.Uuid
  requestId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}

model Client {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)
  phone String @db.VarChar(15)
  birthDate DateTime @db.Date
  comment String @default("") @db.VarChar(1000)
  archived Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assignments TrainerAssignment[]
  memberships Membership[]
  bookings LessonBooking[]
  visits Visit[]
  events CrmEvent[]
  @@index([phone])
  @@index([archived, name, id])
}
model TrainerProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicName String @default("") @db.VarChar(100)
  publicVersion Int @default(1)
  assignments TrainerAssignment[]
  lessons Lesson[]
}
model TrainerAssignment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  trainerId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([trainerId, active, clientId])
}
model MembershipPlan {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  kind String @db.VarChar(10)
  priceCents Int
  months Int
  days Int
  visits Int?
  weekdays String @db.VarChar(13)
  fromTime String @db.VarChar(5)
  toTime String @db.VarChar(5)
  giftGym Boolean
  duo Boolean
  active Boolean @default(true)
  publicVisible Boolean @default(false)
  publicOrder Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model MembershipPurchase {
  id String @id @default(uuid()) @db.Uuid
  totalCents Int
  method String @db.VarChar(10)
  paidAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  purchaseId String @db.Uuid
  purchase MembershipPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  pairId String? @db.Uuid
  snapshot Json
  priceCents Int
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  remaining Int?
  cancelledAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  freezes MembershipFreeze[]
  refunds MembershipRefund[]
  visits Visit[]
  events CrmEvent[]
  @@index([clientId, cancelledAt, startDate])
  @@index([pairId])
}
model MembershipFreeze {
  id String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([membershipId, startDate])
}
model MembershipRefund {
  id String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amountCents Int
  method String @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model CrmEvent {
  id String @id @default(uuid()) @db.Uuid
  clientId String? @db.Uuid
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  membershipId String? @db.Uuid
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String @db.VarChar(64)
  reason String @default("") @db.VarChar(500)
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([clientId, createdAt])
}
model CrmOperation {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  key String @db.Uuid
  fingerprint String @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([actorId,key])
}

model Lesson {
  id String @id @default(uuid()) @db.Uuid
  seriesId String? @db.Uuid
  publicVisible Boolean @default(false)
  publicPreviousStartsAt DateTime? @db.Timestamptz(3)
  publicPreviousEndsAt DateTime? @db.Timestamptz(3)
  kind String @db.VarChar(10)
  title String @db.VarChar(100)
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  trainerId String @db.Uuid
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  room String @default("") @db.VarChar(100)
  capacity Int
  status String @default("SCHEDULED") @db.VarChar(12)
  createdById String @db.Uuid
  createdBy User @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelReason String @default("") @db.VarChar(500)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bookings LessonBooking[]
  visits Visit[]
  events ScheduleEvent[]
  @@index([trainerId, startsAt])
  @@index([status, startsAt])
  @@index([publicVisible, startsAt])
  @@index([seriesId])
}

model LessonBooking {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status String @default("BOOKED") @db.VarChar(12)
  bookedById String @db.Uuid
  bookedBy User @relation("BookingCreatedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelReason String @default("") @db.VarChar(500)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  visits Visit[]
  @@unique([lessonId, clientId])
  @@index([clientId, status])
}

model Visit {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  membershipId String? @db.Uuid
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  lessonId String? @db.Uuid
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  bookingId String? @db.Uuid
  booking LessonBooking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(10)
  entitlement String @db.VarChar(12)
  occurredAt DateTime @db.Timestamptz(3)
  status String @default("CONFIRMED") @db.VarChar(12)
  recordedById String @db.Uuid
  recordedBy User @relation("VisitRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  reversedById String? @db.Uuid
  reversedBy User? @relation("VisitReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reason String @default("") @db.VarChar(500)
  reversedReason String @default("") @db.VarChar(500)
  reversedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([clientId, occurredAt])
  @@index([bookingId])
  @@index([membershipId, status])
  @@index([lessonId, status])
}

model ScheduleEvent {
  id String @id @default(uuid()) @db.Uuid
  lessonId String? @db.Uuid
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String @db.VarChar(64)
  reason String @default("") @db.VarChar(500)
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([lessonId, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id String @id @default(uuid()) @db.Uuid
  endpoint String @unique @db.VarChar(2048)
  p256dh String @db.VarChar(100)
  auth String @db.VarChar(32)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role
  authVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastFailureAt DateTime? @db.Timestamptz(3)
  deliveries PushDelivery[]
  @@index([userId])
}
model PushDelivery {
  id String @id @default(uuid()) @db.Uuid
  eventKey String @db.VarChar(160)
  subscriptionId String @db.Uuid
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role
  authVersion Int
  payload Json
  status String @default("PENDING") @db.VarChar(12)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastStatus Int?
  @@unique([eventKey, subscriptionId])
  @@index([status, availableAt])
}

model ShopProduct {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)
  category String @db.VarChar(100)
  description String @db.VarChar(4000)
  characteristics String @db.VarChar(4000)
  active Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  variants ShopVariant[]
  images ShopImage[]
  @@index([active, name, id])
}
model ShopVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  name String @db.VarChar(150)
  priceCents Int
  available Boolean @default(false)
  active Boolean @default(true)
  version Int @default(1)
  @@unique([productId, name])
}
model ShopImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  data Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([productId, createdAt, id])
}
model ShopOrder {
  id String @id @default(uuid()) @db.Uuid
  number Int @unique @default(autoincrement())
  key String @unique @db.Uuid
  guestHash String @db.VarChar(64)
  fingerprint String @db.VarChar(64)
  name String @db.VarChar(100)
  phone String @db.VarChar(15)
  comment String @db.VarChar(1000)
  method String @db.VarChar(10)
  status String @default("NEW") @db.VarChar(12)
  items Json
  totalCents Int
  version Int @default(1)
  paidAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events ShopOrderEvent[]
  @@index([status, createdAt, id])
}
model ShopOrderEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String @db.VarChar(32)
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}
