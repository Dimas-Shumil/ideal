<%- include('head',{style:'about'}) %>
<main class="about" id="content" tabindex="-1">
<section class="about-hero about__shell" aria-labelledby="about-title"><nav class="about__breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">О клубе</span></nav><p class="about__eyebrow">ИДЕАЛ / АБАКАН</p><h1 id="about-title"><%= about?.title || 'О КЛУБЕ ИДЕАЛ' %></h1>
<% if(about?.summary){ %><div class="about-hero__bottom"><p><%= about.summary %></p></div><% } if(!about){ %><p class="about__muted">Информация о клубе готовится к публикации.</p><% } const facade=about?.photos.find(p=>p.slot==='facade');if(facade){ %><%- include('photo',{photo:facade,className:'about-media about-hero__media'}) %><% } %></section>
<% if(about?.body){ %><section class="about-story about__shell" aria-labelledby="story-title" data-about-reveal><p class="about__eyebrow">01 / О КЛУБЕ</p><div class="about-story__content"><h2 id="story-title"><%= about.storyTitle || 'ТВОЁ МЕСТО ДЛЯ ДВИЖЕНИЯ.' %></h2><div><p class="about__text"><%= about.body %></p></div></div></section><% } const hall=about?.photos.find(p=>p.slot==='hall');if(about?.spaceText||hall){ %><section class="about-space" aria-labelledby="space-title"><div class="about__shell"><div class="about__section-head"><p class="about__eyebrow">02 / ПРОСТРАНСТВО</p><span>IDEAL / MONO</span></div><h2 id="space-title"><%= about.spaceTitle || 'ПРОСТРАНСТВО КЛУБА' %></h2><% if(hall){ %><%- include('photo',{photo:hall,className:'about-media about-space__media'}) %><% } if(about.spaceText){ %><div class="about-space__details"><p class="about__text"><%= about.spaceText %></p></div><% } %></div></section><% } const features=[1,2,3].filter(i=>about?.['feature'+i]&&about?.['feature'+i+'Text']);if(features.length){ %><section class="about-formats about__shell" aria-labelledby="formats-title" data-about-reveal><p class="about__eyebrow">03 / ВОЗМОЖНОСТИ</p><h2 id="formats-title">ВЫБИРАЙ<br><span>СВОЙ ФОРМАТ.</span></h2><ul class="about-formats__list"><% for(const i of features){ %><li><span>0<%= i %></span><h3><%= about['feature'+i] %></h3><p><%= about['feature'+i+'Text'] %></p></li><% } %></ul><a class="about__text-link" href="/#next">Смотреть направления</a></section><% } const gallery=about?.photos.filter(p=>p.slot==='gallery')||[];if(gallery.length){ %><section class="about-gallery about__shell" aria-labelledby="gallery-title"><div class="about__section-head"><p class="about__eyebrow">04 / АТМОСФЕРА</p><span>КЛУБ В ДЕТАЛЯХ</span></div><h2 id="gallery-title">ПОЧУВСТВУЙ<br><span>ЭТО МЕСТО.</span></h2><div class="about-gallery__grid"><% for(const photo of gallery){ %><%- include('photo',{photo,className:'about-media about-gallery__media'}) %><% } %></div></section><% } %>
<section class="about-visit about__shell" aria-labelledby="visit-title" data-about-reveal><p class="about__eyebrow">05 / ДО ВСТРЕЧИ В КЛУБЕ</p><div class="about-visit__layout"><h2 id="visit-title">НАЧНИ<br><span>В СВОЁМ РИТМЕ.</span></h2><div><% const c=typeof siteContacts==='object'?siteContacts:{}; if(c.address){ %><p class="about-visit__address"><%= c.address %></p><% } %><div class="about-visit__actions"><a class="about__button" href="/#memberships">Выбрать абонемент</a><% if(c.map){ %><a class="about__text-link" href="<%= c.map %>" target="_blank" rel="noopener noreferrer">Посмотреть на карте</a><% } %></div></div></div></section>
</main><script src="/site/scripts/about.js" defer></script><%- include('../public/footer') %>
