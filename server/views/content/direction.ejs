<%- include('head',{style:'direction'}) %><main class="direction" id="content" tabindex="-1"><div class="direction__shell"><nav class="direction__breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/#next">Направления</a></nav>
<% if(!item){ %><h1>Направление не найдено</h1><p>Вернитесь к опубликованным направлениям клуба.</p><% }else{ %><p class="direction__eyebrow">ИДЕАЛ / НАПРАВЛЕНИЯ</p><h1><%= item.title %></h1><p class="direction__summary"><%= item.summary %></p><% const cover=item.photos.find(p=>p.slot==='cover');if(cover){ %><%- include('photo',{photo:cover,className:'direction__cover'}) %><% } %><div class="direction__body"><p><%= item.body %></p></div><% const gallery=item.photos.filter(p=>p.slot==='gallery');if(gallery.length){ %><div class="direction__gallery" aria-label="Фотографии направления"><% for(const photo of gallery){ %><%- include('photo',{photo,className:'direction__photo'}) %><% } %></div><% } %><% } %>
<div class="direction__links"><a href="/#memberships">Смотреть абонементы</a><a href="/schedule.html">Смотреть расписание</a><a href="/trainers.html">Смотреть тренеров</a></div></div></main><%- include('../public/footer') %>
