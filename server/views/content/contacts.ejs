<div class="ideal-footer__contacts">
  <h2>Контакты</h2>
  <% if(siteContacts.address){ %><address><%= siteContacts.address %></address><% } %>
  <% if(siteContacts.phone){ %><a href="tel:<%= siteContacts.phone %>"><%= siteContacts.phoneDisplay || siteContacts.phone %></a><% } %>
  <p class="ideal-footer__booking-note">Для записи на тренировку позвоните в клуб. Онлайн-записи пока нет.</p>
  <% if(siteContacts.hours){ %><p class="ideal-footer__hours"><%= siteContacts.hours %></p><% } %>
  <% if(siteContacts.map){ %><a href="<%= siteContacts.map %>" target="_blank" rel="noopener noreferrer">Посмотреть на карте</a><% } %>
  <% if(siteContacts.vk){ %><a href="<%= siteContacts.vk %>" target="_blank" rel="noopener noreferrer">ВКонтакте</a><% } %>
  <% if(siteContacts.telegram){ %><a href="<%= siteContacts.telegram %>" target="_blank" rel="noopener noreferrer">Telegram</a><% } %>
</div>
