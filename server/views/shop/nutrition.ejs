<% if(items.length){ %>
<section class="nutrition" id="nutrition" aria-labelledby="nutrition-title"><div class="nutrition__shell"><div class="nutrition__eyebrow"><span>03 / СПОРТИВНОЕ ПИТАНИЕ</span><span>ИДЕАЛ / МАГАЗИН</span></div><div class="nutrition__intro"><h2 class="nutrition__heading" id="nutrition-title">ЭНЕРГИЯ<br>ДЛЯ БОЛЬШЕГО.</h2><p class="nutrition__lead">Спортивное питание. Самовывоз из клуба, оплата при получении. Наличие подтверждает сотрудник.</p></div>
<% const first=items[0];const price=p=>p.variants.length?'От '+money(Math.min(...p.variants.map(v=>v.priceCents)))+' ₽':'Варианты ожидаются'; %><div class="nutrition__gallery" tabindex="0" role="region" aria-roledescription="карусель" aria-label="Спортивное питание: используйте стрелки влево и вправо" aria-describedby="nutrition-gesture"><div class="nutrition__stage"><% for(const [index,p] of items.entries()){ %><article class="nutrition-card" data-nutrition-card data-product-id="<%= p.id %>" data-name="<%= p.name %>" data-category="<%= p.category %>" data-description="<%= p.description %>" data-price="<%= price(p) %>" role="group" aria-roledescription="слайд" aria-label="<%= index+1 %> из <%= items.length %>: <%= p.name %>"><div class="nutrition-card__top"><span>ИДЕАЛ</span><span><%= String(index+1).padStart(2,'0') %></span></div><img class="nutrition-card__image" src="<%= p.images.length?'/shop/images/'+p.images[0].id+'.webp':'/site/img/shop-placeholder.svg' %>" alt="<%= p.name %>" width="600" height="760" loading="lazy" draggable="false"><div class="nutrition-card__bottom"><span><%= p.category %></span><span>СПОРТ / ПИТАНИЕ</span></div></article><% } %></div></div>
<div class="nutrition__navigation"><p class="nutrition__gesture" id="nutrition-gesture"><%= items.length > 1 ? 'Перетаскивай, чтобы выбрать' : 'Пока опубликован один товар' %></p><div class="nutrition__controls"><button class="nutrition__nav" type="button" data-nutrition-prev disabled title="<%= items.length === 1 ? 'Пока опубликован один товар' : 'Предыдущий товар' %>" aria-label="Предыдущий товар">Назад</button><span class="nutrition__counter" data-nutrition-counter>01 / <%= String(items.length).padStart(2,'0') %></span><button class="nutrition__nav" type="button" data-nutrition-next disabled title="<%= items.length === 1 ? 'Пока опубликован один товар' : 'Следующий товар' %>" aria-label="Следующий товар">Далее</button></div></div><div class="nutrition__details"><div class="nutrition__identity"><p class="nutrition__category" data-nutrition-category><%= first.category %></p><h3 class="nutrition__name" data-nutrition-name><%= first.name %></h3></div><p class="nutrition__description" data-nutrition-description><%= first.description %></p><div class="nutrition__purchase"><p class="nutrition__price" data-nutrition-price><%= price(first) %></p><a class="nutrition__buy" data-nutrition-buy href="/product.html?id=<%= first.id %>">Выбрать вариант</a></div></div><p class="nutrition__status" role="status" aria-live="polite" aria-atomic="true" data-nutrition-status></p><div class="nutrition__footer"><p>Заказ без регистрации.<br>Сотрудник свяжется с вами для подтверждения.</p><a class="nutrition__store" href="/shop.html">Перейти в магазин</a></div></div></section>

<% } %>
