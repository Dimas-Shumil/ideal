<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Магазин — ИДЕАЛ</title><link rel="stylesheet" href="/site/css/owner.css"><link rel="stylesheet" href="/site/css/shop-panel.css"><script src="/site/scripts/owner.js" defer></script></head><body class="panel shop-panel"><a class="panel__skip" href="#content">К содержимому</a><header class="panel__header"><a class="panel__brand" href="<%= user.role==='OWNER'?'/admin':'/crm/clients' %>">ИДЕАЛ<span>Магазин</span></a><span><%= user.displayName %></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Выйти</button></form></header><div class="panel__layout"><%- include('../partials/panel-nav') %><main class="panel__main" id="content">
<% if(page==='orders'){ %><h1>Заказы магазина</h1><form class="shop-panel__filters" method="get" action="/shop-panel/orders"><label>Статус<select name="status"><option value="">Все</option><% for(const [v,l] of Object.entries(statuses)){ %><option value="<%= v %>" <%= query.status===v?'selected':'' %>><%= l %></option><% } %></select></label><button>Показать</button></form><p>Заказов: <%= total %>. Страница <%= query.page %>.</p><div class="shop-panel__grid"><% for(const o of orders){ %><article class="panel__card"><h2><a href="/shop-panel/orders/<%= o.id %>">Заказ № <%= o.number %></a></h2><p><%= statuses[o.status] %> · <%= money(o.totalCents) %> ₽</p><p><%= o.name %> · <%= o.phone %></p><p><%= o.createdAt.toLocaleString('ru-RU',{timeZone:'Asia/Krasnoyarsk'}) %></p></article><% } %></div><% if(!orders.length){ %><p>Заказов пока нет.</p><% } %><nav class="shop-panel__pagination" aria-label="Страницы заказов"><% if(query.page>1){ %><a href="/shop-panel/orders?<%= new URLSearchParams({status:query.status,page:String(query.page-1)}) %>">Назад</a><% } if(query.page*25<total){ %><a href="/shop-panel/orders?<%= new URLSearchParams({status:query.status,page:String(query.page+1)}) %>">Далее</a><% } %></nav>
<% }else if(page==='order'){ %><h1>Заказ № <%= order.number %></h1><p>Статус: <%= statuses[order.status] %></p><article class="panel__card"><h2>Покупатель</h2><p><%= order.name %> · <a href="tel:+<%= order.phone %>"><%= order.phone %></a></p><p class="shop-panel__text"><%= order.comment %></p><p>Самовывоз из клуба. <%= methods[order.method] %>.</p><p><%= order.paidAt?'Оплата отмечена при выдаче: '+order.paidAt.toLocaleString('ru-RU',{timeZone:'Asia/Krasnoyarsk'}):'Оплата не отмечена' %></p></article><article class="panel__card"><h2>Состав заказа</h2><ul><% for(const item of order.items){ %><li><%= item.name %> / <%= item.variant %>: <%= item.quantity %> × <%= money(item.priceCents) %> ₽ = <%= money(item.quantity*item.priceCents) %> ₽</li><% } %></ul><h3>Итого: <%= money(order.totalCents) %> ₽</h3><p>Зафиксировано при оформлении. Изменения каталога сумму заказа не меняют. Складской резерв отсутствует.</p></article>
<% const next={NEW:'CONFIRMED',CONFIRMED:'READY',READY:'ISSUED'}[order.status]; if(next){ %><form class="panel__card shop-panel__form" method="post" action="/shop-panel/orders/<%= order.id %>/status"><%- include('operation',{version:order.version}) %><input type="hidden" name="status" value="<%= next %>"><h2><%= next==='ISSUED'?'Подтвердить оплату и выдачу':'Следующий статус' %></h2><% if(next==='ISSUED'){ %><p>Подтверждаете фактически полученную полную оплату <%= money(order.totalCents) %> ₽. Банковская операция не выполняется.</p><label>Фактический способ оплаты<select name="method"><% for(const [v,l] of Object.entries(methods)){ %><option value="<%= v %>" <%= order.method===v?'selected':'' %>><%= l %></option><% } %></select></label><% }else{ %><input type="hidden" name="method" value="<%= order.method %>"><% } %><input type="hidden" name="reason" value=""><button><%= next==='ISSUED'?'Оплата получена, товар выдан':statuses[next] %></button></form><form class="panel__card shop-panel__form" method="post" action="/shop-panel/orders/<%= order.id %>/status"><%- include('operation',{version:order.version}) %><input type="hidden" name="status" value="CANCELLED"><input type="hidden" name="method" value="<%= order.method %>"><label>Причина отмены<textarea name="reason" minlength="3" maxlength="500" required></textarea></label><button>Отменить заказ</button></form><% } %>
<section class="panel__card"><h2>История</h2><% for(const e of order.events){ %><p><%= e.createdAt.toLocaleString('ru-RU',{timeZone:'Asia/Krasnoyarsk'}) %> · <%= statuses[e.action]||e.action %> · <%= e.actor?.displayName||(e.action==='NEW'?'Покупатель':'Сотрудник удалён') %></p><% if(e.reason){ %><p><%= e.reason %></p><% } %><% } %></section><a href="/shop-panel/orders">Все заказы</a>
<% }else if(page==='products'){ %><div class="panel__heading"><h1>Товары</h1><a class="panel__button" href="/shop-panel/products/new">Добавить товар</a></div><p>Товаров: <%= total %>. Цены и наличие задаются в вариантах. Ассортимент вносится по данным клуба.</p><div class="shop-panel__grid"><% for(const p of products){ %><article class="panel__card"><h2><a href="/shop-panel/products/<%= p.id %>"><%= p.name %></a></h2><p><%= p.category %> · <%= p.active?'Опубликован':'Скрыт' %></p></article><% } %></div><nav class="shop-panel__pagination" aria-label="Страницы товаров"><% if(query.page>1){ %><a href="?page=<%= query.page-1 %>">Назад</a><% } if(query.page*25<total){ %><a href="?page=<%= query.page+1 %>">Далее</a><% } %></nav>
<% }else if(page==='product'){ %><h1><%= product?'Редактировать товар':'Новый товар' %></h1><form class="panel__card shop-panel__form" method="post" action="/shop-panel/products<%= product?'/'+product.id:'' %>"><%- include('operation',{version:product?.version}) %><label>Название<input name="name" value="<%= product?.name||'' %>" minlength="2" maxlength="150" required></label><label>Категория<input name="category" value="<%= product?.category||'' %>" maxlength="100" required></label><label>Описание<textarea name="description" maxlength="4000" rows="5"><%= product?.description||'' %></textarea></label><label>Характеристики<textarea name="characteristics" maxlength="4000" rows="5"><%= product?.characteristics||'' %></textarea></label><label>Публикация<select name="active"><option value="false" <%= !product?.active?'selected':'' %>>Скрыт</option><option value="true" <%= product?.active?'selected':'' %>>Опубликован</option></select></label><button>Сохранить товар</button></form>
<% if(product){ %><section><h2>Варианты: вкус, фасовка, характеристики</h2><p>Укажите сочетание в названии варианта. У каждого — одна цена и собственное наличие. Количественный учёт не ведётся.</p><% for(const variant of product.variants){ %><%- include('variant-form',{variant,product}) %><% } %><h3>Добавить вариант</h3><%- include('variant-form',{variant:null,product}) %></section><section><h2>Галерея</h2><p>До 8 фотографий. JPEG, PNG или WebP до 5 МБ и 20 мегапикселей. Первое загруженное фото — обложка. Для замены загрузите новое и удалите прежнее.</p><div class="shop-panel__gallery"><% for(const image of product.images){ %><article class="panel__card"><img src="/shop/images/<%= image.id %>.webp" alt="<%= product.name %>" width="220" height="220"><form method="post" action="/shop-panel/images/<%= image.id %>/remove"><%- include('operation',{version:product.version}) %><button>Удалить фото</button></form></article><% } %></div><% if(product.images.length<8){ %><form class="panel__card shop-panel__form" method="post" enctype="multipart/form-data" action="/shop-panel/products/<%= product.id %>/images"><%- include('operation',{version:product.version}) %><label>Фотография<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><button>Загрузить фото</button></form><% } %></section><p><a href="/product.html?id=<%= product.id %>">Открыть публичную карточку</a> (скрытый товар публично недоступен)</p><% } %><a href="/shop-panel/products">Все товары</a><% } %><p class="panel__busy" role="status" aria-live="polite"></p></main></div></body></html>
