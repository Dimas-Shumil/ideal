<form class="panel__card shop-panel__form" method="post" action="/shop-panel/products/<%= product.id %>/variants<%= variant?'/'+variant.id:'' %>"><%- include('operation',{version:variant?.version}) %><label>Название варианта<input name="name" value="<%= variant?.name||'' %>" maxlength="150" required></label><label>Цена, ₽<input name="price" inputmode="decimal" value="<%= variant?(variant.priceCents/100).toFixed(2):'' %>" pattern="[0-9]{1,7}([.,][0-9]{1,2})?" required></label><label>Наличие<select name="available"><option value="false" <%= !variant?.available?'selected':'' %>>Нет в наличии</option><option value="true" <%= variant?.available?'selected':'' %>>В наличии</option></select></label><label>Публикация варианта<select name="active"><option value="true" <%= variant?.active!==false?'selected':'' %>>Показан</option><option value="false" <%= variant?.active===false?'selected':'' %>>Скрыт</option></select></label><button><%= variant?'Сохранить вариант':'Добавить вариант' %></button></form>
