<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><title>ИДЕАЛ — рабочий кабинет</title><link rel="stylesheet" href="/site/css/owner.css"><link rel="stylesheet" href="/site/css/coach.css"><script src="/site/scripts/owner.js" defer></script><%- include('../partials/pwa-head') %></head>
<body class="panel coach"><a class="panel__skip" href="#content">К содержимому</a>
<header class="panel__header"><a class="panel__brand" href="<%= user.role==='OWNER'?'/admin':'/trainer' %>"><img class="brand__image" src="/site/img/brand/ideal-logo-orange-v4.webp" alt="ИДЕАЛ" width="256" height="256"><span><%= user.role==='OWNER'?'Панель владельца':'Кабинет тренера' %></span></a><span><%= user.displayName %></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Выйти</button></form></header>
<div class="panel__layout"><%- include('../partials/panel-nav') %><main class="panel__main" id="content">
<% const titles={overview:'Обзор',clients:'Персональные клиенты',sessions:'Персональные тренировки',expenses:'Финансы',tasks:'Задачи и напоминания',calendar:'Календарь',statistics:'Статистика'}; const statuses={SCHEDULED:'Запланирована',COMPLETED:'Проведена',CANCELLED:'Отменена'}; %>
<% if(page==='owners'){ %><h1>Работа тренеров</h1><form class="panel__filters" method="get"><label>Месяц<input type="month" name="month" required value="<%= filters.month %>"></label><button>Показать</button></form>
<p>Доход персональных тренировок учитывается по дате проведённого занятия. Это отдельный учёт от оплат абонементов клуба.</p>
<div class="coach__grid"><% rows.forEach(row=>{ %><article class="panel__card"><h2><%= row.displayName %></h2><p><%= row.active?'Активен':'Отключён' %><%= row.role!=='TRAINER'?' · Архив кабинета':'' %></p><dl class="coach__numbers"><dt>Доход</dt><dd><%= money(row.stats.incomeCents) %> ₽</dd><dt>Расходы</dt><dd><%= money(row.stats.expenseCents) %> ₽</dd><dt>Разница</dt><dd><%= money(row.stats.balanceCents) %> ₽</dd><dt>Персональных проведено</dt><dd><%= row.stats.completed %></dd><dt>Отменено</dt><dd><%= row.stats.cancelled %></dd><dt>Посещений на занятиях клуба</dt><dd><%= row.stats.attendance %></dd></dl><a class="panel__button" href="<%= base+'/'+row.id+'?month='+filters.month %>">Открыть кабинет</a></article><% }); %></div><% if(!rows.length){ %><p class="coach__empty">Тренеров пока нет.</p><% } %>
<% }else if(page==='error'){ %><h1>Не удалось сохранить</h1><p class="panel__error" role="alert" tabindex="-1"><%= message %></p><a href="<%= back %>">Вернуться к списку</a>
<% }else{ %>
<% if(readOnly){ %><a href="/admin/trainer-workspaces?month=<%= filters.month %>">Все тренеры</a><p class="panel__eyebrow">Кабинет: <%= coach.displayName %></p><% } %>
<nav class="coach__tabs" aria-label="Разделы кабинета"><% for(const [key,label] of Object.entries(titles)){ %><a href="<%= base+(key==='overview'?'':'/'+key)+'?month='+filters.month %>" <%- page===key?'aria-current="page"':'' %>><%= label %></a><% } %></nav>
<% if(page==='form'){ %><%- include('form',{kind,item,statuses,clients:typeof clients==='undefined'?[]:clients}) %>
<% }else{ %><div class="panel__heading"><h1><%= titles[page] %></h1><% if(!readOnly&&['clients','sessions','expenses','tasks'].includes(page)){ %><a class="panel__button" href="<%= base+'/'+page+'/new' %>"><%= page==='clients'?'Добавить клиента':page==='sessions'?'Запланировать тренировку':page==='expenses'?'Добавить расход':'Добавить задачу' %></a><% } %></div>
<form class="panel__filters" method="get"><% if(page!=='tasks'&&page!=='clients'){ %><label>Месяц<input type="month" name="month" value="<%= filters.month %>" required></label><% } %><% if(page==='clients'){ %><label>Клиенты<select name="archived"><option value="false">Действующие</option><option value="true" <%= filters.archived==='true'?'selected':'' %>>В архиве</option></select></label><% } if(page==='tasks'){ %><label>Задачи<select name="completed"><option value="false">Открытые</option><option value="true" <%= filters.completed==='true'?'selected':'' %>>Завершённые</option></select></label><% } %><button>Показать</button></form>
<% if(['overview','statistics','expenses'].includes(page)){ %><div class="coach__metrics"><% for(const [label,value] of [['Доход',money(stats.incomeCents)+' ₽'],['Расходы',money(stats.expenseCents)+' ₽'],['Разница',money(stats.balanceCents)+' ₽'],['Персональных проведено',stats.completed],['Активных клиентов',stats.clients],['Предстоящих тренировок',stats.upcoming]]){ %><section class="panel__card"><h2><%= label %></h2><strong><%= value %></strong></section><% } %></div><p class="coach__muted">Доход — стоимость проведённых персональных тренировок за выбранный месяц. Расходы учитываются по дате записи. Оплаты абонементов клуба сюда не входят.</p><% } %>
<% if(page==='statistics'){ %><section class="panel__card"><h2>Тренировки и посещения</h2><dl class="coach__numbers"><dt>Отменено персональных</dt><dd><%= stats.cancelled %></dd><dt>Открытых задач</dt><dd><%= stats.tasks %></dd><dt>Занятий в расписании клуба за месяц</dt><dd><%= stats.clubLessons %></dd><dt>Фактических посещений на занятиях клуба</dt><dd><%= stats.attendance %></dd></dl></section>
<% }else if(page==='calendar'){const events=[...items.map(x=>({...x,label:x.client.name+' · '+statuses[x.status],url:base+'/sessions/'+x.id})),...lessons.map(x=>({...x,label:x.title+' · Занятие клуба',url:(readOnly?'/crm/schedule/':'/trainer/lessons/')+x.id}))].sort((a,b)=>a.startsAt-b.startsAt); %><div class="coach__list"><% for(const event of events){ %><article class="panel__card"><p class="coach__muted"><%= club(event.startsAt).date %> · <%= club(event.startsAt).time %>–<%= club(event.endsAt).time %></p><h2><a href="<%= event.url %>"><%= event.label %></a></h2></article><% } %><% if(!events.length){ %><p class="coach__empty">В этом месяце нет тренировок.</p><% } %></div>
<% }else{ %>
<% if(page==='overview'){ %><h2>Предстоящие персональные тренировки</h2><% } %>
<div class="coach__list"><% for(const item of items){ %><article class="panel__card">
<% if(page==='clients'){ %><h2><%= item.name %></h2><% if(item.phone){ %><p><a href="tel:<%= item.phone.replace(/[^+0-9]/g,'') %>"><%= item.phone %></a></p><% } %><p class="coach__text"><%= item.notes %></p>
<% }else if(page==='tasks'){ %><p class="coach__badge"><%= item.completed?'Завершена':item.priority==='IMPORTANT'?'Важная':'Открыта' %></p><h2><%= item.title %></h2><p><%= item.dueAt?'Срок: '+club(item.dueAt).date+' '+club(item.dueAt).time:'Без срока' %></p><% if(item.reminderAt){ %><p>Напоминание: <%= club(item.reminderAt).date %> <%= club(item.reminderAt).time %></p><% } %><p class="coach__text"><%= item.comment %></p>
<% }else if(page==='expenses'){ %><h2><%= item.title %></h2><p><%= item.category %> · <%= club(item.expenseDate).date %></p><strong><%= money(item.amountCents) %> ₽</strong><p class="coach__text"><%= item.comment %></p>
<% }else{ %><p class="coach__muted"><%= club(item.startsAt).date %> · <%= club(item.startsAt).time %>–<%= club(item.endsAt).time %></p><h2><%= item.client.name %></h2><p><%= statuses[item.status] %> · <%= money(item.priceCents) %> ₽</p><% if(item.reminderMinutes){ %><p>Напоминание за <%= item.reminderMinutes===1440?'сутки':item.reminderMinutes===120?'2 часа':'3 часа' %></p><% } %><p class="coach__text"><%= item.comment %></p><% } %>
<a href="<%= base+'/'+(page==='overview'?'sessions':page)+'/'+item.id %>"><%= readOnly?'Открыть запись':'Открыть и редактировать' %></a></article><% } %>
<% if(!items.length){ %><p class="coach__empty">Записей пока нет.</p><% } %></div>
<% if(page==='overview'){ %><h2>Открытые задачи</h2><div class="coach__list"><% tasks.forEach(task=>{ %><article class="panel__card"><h3><a href="<%= base+'/tasks/'+task.id %>"><%= task.title %></a></h3><p><%= task.dueAt?club(task.dueAt).date+' '+club(task.dueAt).time:'Без срока' %></p></article><% }); %><% if(!tasks.length){ %><p class="coach__empty">Открытых задач нет.</p><% } %></div><% if(!readOnly){ %><p><a href="/notifications">Настроить Push-уведомления</a> · <a href="/trainer/lessons">Расписание клуба и посещения</a></p><% } %><% } %>
<% } %><% } %><% } %>
<% if(typeof total==='number'&&total>25){const q=new URLSearchParams({month:filters.month,archived:filters.archived,completed:filters.completed}); %><nav class="panel__pagination" aria-label="Страницы"><% if(filters.page>1){q.set('page',String(filters.page-1)); %><a href="?<%= q.toString() %>">Предыдущая</a><% } if(filters.page*25<total){q.set('page',String(filters.page+1)); %><a href="?<%= q.toString() %>">Следующая</a><% } %></nav><% } %>
<p class="panel__busy" role="status" aria-live="polite"></p></main></div></body></html>
