<title><%= seo.title %></title><meta name="description" content="<%= seo.description %>"><meta name="robots" content="<%= seo.robots %>">
<% if (seo.canonical) { %>
<link rel="canonical" href="<%= seo.canonical %>">
<meta property="og:type" content="website"><meta property="og:locale" content="ru_RU"><meta property="og:site_name" content="ИДЕАЛ">
<meta property="og:title" content="<%= seo.title %>"><meta property="og:description" content="<%= seo.description %>"><meta property="og:url" content="<%= seo.canonical %>"><meta property="og:image" content="<%= seo.origin %>/site/img/hero-desktop.webp"><meta name="twitter:card" content="summary_large_image">
<% } %>
