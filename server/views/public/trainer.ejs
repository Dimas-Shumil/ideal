<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f7f7f5"><%- include('../public/seo-meta') %><link rel="stylesheet" href="/site/css/main.css"><link rel="stylesheet" href="/site/css/trainer.css"><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/site/img/pwa/apple-touch-180-v1.png"><link rel="stylesheet" href="/site/css/pwa-install.css"><script src="/site/scripts/pwa.js" defer></script><script src="/site/scripts/pwa-install.js" defer></script><link rel="stylesheet" href="/site/css/brand-v1.css">
<link rel="icon" type="image/png" sizes="32x32" href="/site/img/brand/favicon-32-v1.png">
<link rel="icon" type="image/png" sizes="16x16" href="/site/img/brand/favicon-16-v1.png">
<link rel="shortcut icon" href="/site/img/brand/favicon-v1.ico">
</head><body class="trainer-page"><a class="trainer__skip" href="#content">К содержимому</a><%- include('header') %>
<main class="trainer" id="content" tabindex="-1"><div class="trainer__shell">
<nav class="trainer__breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><a href="/trainers.html">Тренеры</a><% if(profile){ %><span aria-hidden="true">/</span><span aria-current="page"><%= profile.name %></span><% } %></nav>
<% if(!profile){ %><div class="trainer__notice"><h1><%= unavailable ? 'Профиль временно недоступен' : 'Страница не найдена' %></h1><p><%= unavailable ? 'Попробуйте обновить страницу позже.' : 'Вернитесь в каталог опубликованных тренеров клуба.' %></p><a class="trainer__button" href="/trainers.html">Каталог тренеров</a></div>
<% }else{ %>
<section class="trainer__hero" aria-labelledby="trainer-name"><figure class="trainer__portrait"><img src="<%= profile.photoUrl %>" alt="<%= profile.hasPhoto ? 'Фото: '+profile.name : '' %>" width="800" height="1000"><% if(!profile.hasPhoto){ %><figcaption><span>ФОТО ОЖИДАЕТСЯ</span><strong class="brand__placeholder"><img class="brand__image" src="/site/img/brand/ideal-logo-v1.webp" alt="ИДЕАЛ" width="256" height="256" decoding="async"></strong><span>Фотография пока не добавлена.</span></figcaption><% } %></figure><div class="trainer__intro" data-trainer-reveal><p class="trainer__eyebrow">ИДЕАЛ / ТРЕНЕР</p><h1 id="trainer-name"><%= profile.name %></h1><% if(profile.specialty){ %><p class="trainer__specialty"><%= profile.specialty %></p><% } %><% if(profile.summary){ %><p class="trainer__description"><%= profile.summary %></p><% } %><a class="trainer__button" href="/schedule.html">Смотреть расписание</a><a class="trainer__link" href="/trainers.html">Вернуться в каталог тренеров</a></div></section>
<% const blocks=[['О тренере',[['Биография','biography'],['Опыт работы','experience'],['Образование и квалификация','qualification']]],['Подход к тренировкам',[['Подход','approach'],['Направления работы','directions']]],['Достижения',[['Достижения','achievements']]]]; blocks.forEach(([title,fields],index)=>{const shown=fields.filter(([,key])=>profile[key]);if(!shown.length)return; %><section class="trainer__section" aria-labelledby="detail-<%= index %>" data-trainer-reveal><div class="trainer__section-head"><h2 id="detail-<%= index %>"><%= title %></h2></div><dl class="trainer__facts"><% shown.forEach(([label,key])=>{ %><div><dt><%= label %></dt><dd><%= profile[key] %></dd></div><% }); %></dl></section><% }); %>
<% } %></div></main><script src="/site/scripts/trainer.js" defer></script><%- include('footer') %>
