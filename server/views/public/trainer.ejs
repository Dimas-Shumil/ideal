<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f7f7f5"><%- include('../public/seo-meta') %><link rel="stylesheet" href="/site/css/main.css"><link rel="stylesheet" href="/site/css/trainer.css"><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/site/img/pwa/apple-touch-180-orange-v3.png"><link rel="stylesheet" href="/site/css/pwa-install.css"><script src="/site/scripts/pwa.js" defer></script><script src="/site/scripts/pwa-install.js" defer></script><link rel="stylesheet" href="/site/css/brand-v1.css">
<link rel="icon" type="image/png" sizes="32x32" href="/site/img/brand/favicon-32-orange-v4.png">
<link rel="icon" type="image/png" sizes="16x16" href="/site/img/brand/favicon-16-orange-v4.png">
<link rel="shortcut icon" href="/site/img/brand/favicon-orange-v4.ico">
<link rel="stylesheet" href="/site/css/trainer-gallery.css?v=20261117-5"><script src="/site/scripts/trainer-gallery.js?v=20261117-5" defer></script>
</head><body class="trainer-page"><a class="trainer__skip" href="#content">К содержимому</a><%- include('header') %>
<main class="trainer" id="content" tabindex="-1"><div class="trainer__shell">
<nav class="trainer__breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><a href="/trainers.html">Тренеры</a><% if(profile){ %><span aria-hidden="true">/</span><span aria-current="page"><%= profile.name %></span><% } %></nav>
<% if(!profile){ %><div class="trainer__notice"><h1><%= unavailable ? 'Профиль временно недоступен' : 'Страница не найдена' %></h1><p><%= unavailable ? 'Попробуйте обновить страницу позже.' : 'Вернитесь в каталог опубликованных тренеров клуба.' %></p><a class="trainer__button" href="/trainers.html">Каталог тренеров</a></div>
<% }else{ %>
<section class="trainer__hero" aria-labelledby="trainer-name"><figure class="trainer__portrait"><img src="<%= profile.photoUrl %>" alt="<%= profile.hasPhoto ? 'Фото: '+profile.name : '' %>" width="800" height="1000"><% if(!profile.hasPhoto){ %><figcaption><span>ФОТО ОЖИДАЕТСЯ</span><strong class="brand__placeholder"><img class="brand__image" src="/site/img/brand/ideal-logo-orange-v4.webp" alt="ИДЕАЛ" width="256" height="256" decoding="async"></strong><span>Фотография пока не добавлена.</span></figcaption><% } %></figure><div class="trainer__intro" data-trainer-reveal><p class="trainer__eyebrow">ИДЕАЛ / ТРЕНЕР</p><h1 id="trainer-name"><%= profile.name %></h1><% if(profile.specialty){ %><p class="trainer__specialty"><%= profile.specialty %></p><% } %><% if(profile.summary){ %><p class="trainer__description"><%= profile.summary %></p><% } %><% if(profile.phone || profile.vkUrl || profile.maxUrl){ %><div class="trainer__contacts" aria-label="Связаться с тренером">
<% if(profile.phone){ %><a class="trainer__contact" href="tel:<%= profile.phone.replace(/[^+0-9]/g,'') %>"><%= profile.phone %></a><% } %>
<% for(const [key,label,icon] of [['vkUrl','ВКонтакте','vk.svg'],['maxUrl','MAX','max-logo.svg']]){ if(profile[key]){ %><a class="trainer__contact" href="<%= profile[key] %>" target="_blank" rel="noopener noreferrer"><img src="/site/img/social/<%= icon %>" alt="" width="24" height="24"><%= label %></a><% }} %>
</div><% } %><a class="trainer__button" href="/schedule.html">Смотреть расписание</a><a class="trainer__link" href="/trainers.html">Вернуться на страницу тренеров</a></div></section>
<% const blocks=[['О тренере',[['Биография','biography'],['Опыт работы','experience'],['Образование и квалификация','qualification']]],['Подход к тренировкам',[['Подход','approach'],['Направления работы','directions']]],['Достижения',[['Достижения','achievements']]]]; blocks.forEach(([title,fields],index)=>{const shown=fields.filter(([,key])=>profile[key]);if(!shown.length)return; %><section class="trainer__section" aria-labelledby="detail-<%= index %>" data-trainer-reveal><div class="trainer__section-head"><h2 id="detail-<%= index %>"><%= title %></h2></div><dl class="trainer__facts"><% shown.forEach(([label,key])=>{ %><div><dt><%= label %></dt><dd><%= profile[key] %></dd></div><% }); %></dl></section><% }); %>
<% if(profile.gallery && profile.gallery.length){ %><section class="trainer__section trainer-gallery-section" aria-labelledby="gallery-title"><div class="trainer-gallery-heading"><div><p class="trainer-gallery-eyebrow">ЖИЗНЬ КЛУБА / ТРЕНИРОВКИ</p><h2 id="gallery-title">Фотографии с тренировок</h2></div><div class="trainer-gallery-controls" data-gallery-controls hidden><span data-gallery-position aria-live="polite"></span><button type="button" data-gallery-back aria-label="Предыдущие фотографии"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button><button type="button" data-gallery-forward aria-label="Следующие фотографии"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button></div></div><div class="trainer-gallery" data-gallery-track tabindex="0" role="region" aria-label="Фотографии с тренировок: листайте в сторону"><% profile.gallery.forEach((photo,index)=>{ %><figure><a href="<%= photo.url %>" data-gallery-photo data-caption="<%= photo.caption %>" aria-label="Открыть фотографию <%= index+1 %>"><img src="<%= photo.url %>" alt="<%= photo.caption || 'Фото с тренировок: '+profile.name %>" width="640" height="480" loading="lazy" decoding="async"></a><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }); %></div></section>
<dialog class="trainer-gallery-viewer" aria-label="Просмотр фотографий"><button class="trainer-gallery-viewer__close" type="button" data-gallery-close aria-label="Закрыть фотографию"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><img data-gallery-image alt=""><p data-gallery-caption></p></dialog><% } %>
<% } %></div></main><script src="/site/scripts/trainer.js" defer></script><%- include('footer') %>
