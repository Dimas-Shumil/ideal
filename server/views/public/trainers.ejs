<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f7f7f5"><%- include('../public/seo-meta') %><link rel="stylesheet" href="/site/css/main.css"><link rel="stylesheet" href="/site/css/trainers.css"><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/site/img/pwa/apple-touch-180-v1.png"><link rel="stylesheet" href="/site/css/pwa-install.css"><script src="/site/scripts/pwa.js" defer></script><script src="/site/scripts/pwa-install.js" defer></script><link rel="stylesheet" href="/site/css/brand-v1.css">
<link rel="icon" type="image/png" sizes="32x32" href="/site/img/brand/favicon-32-v1.png">
<link rel="icon" type="image/png" sizes="16x16" href="/site/img/brand/favicon-16-v1.png">
<link rel="shortcut icon" href="/site/img/brand/favicon-v1.ico">
</head><body class="trainers-page"><a class="trainers-page__skip" href="#content">К содержимому</a><%- include('header') %>
<main class="trainers" id="content" tabindex="-1"><div class="trainers__shell">
<nav class="trainers__breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Тренеры</span></nav>
<section class="trainers__intro"><p class="trainers__eyebrow">ИДЕАЛ / ТРЕНЕРЫ</p><h1>ТВОЙ ТРЕНЕР.<br><span>ТВОЙ РИТМ.</span></h1><div class="trainers__intro-bottom"><p>Начни с знакомства.</p><p class="trainers__description">Специализация и подход к тренировкам — в профилях тренеров клуба.</p></div></section>
<section aria-labelledby="catalog-title"><div class="trainers__catalog-head"><h2 id="catalog-title">ТРЕНЕРЫ КЛУБА</h2><% if(!unavailable){ %><span>ПРОФИЛЕЙ: <%= items.length %></span><% } %></div>
<% if(unavailable){ %><div class="trainers__notice" role="status"><h2>Каталог временно недоступен</h2><p>Попробуйте обновить страницу позже.</p><a href="/trainers.html">Обновить каталог</a></div>
<% }else if(!items.length){ %><p class="trainers__notice">Профили тренеров пока не опубликованы.</p>
<% }else{ %><ul class="trainers__grid"><% items.forEach((item,index)=>{ %><li class="trainer-card" data-trainer-reveal><article aria-labelledby="trainer-<%= index %>"><div class="trainer-card__visual"><img src="<%= item.photoUrl %>" alt="<%= item.hasPhoto ? 'Фото: '+item.name : '' %>" width="800" height="1000" loading="lazy" decoding="async"><span class="trainer-card__index"><%= String(index+1).padStart(2,'0') %><% if(!item.hasPhoto){ %> / ФОТО ОЖИДАЕТСЯ<% } %></span><span class="trainer-card__stamp" aria-hidden="true">IDEAL<br>PERSONAL</span></div><div class="trainer-card__info"><p class="trainer-card__label">ТРЕНЕР КЛУБА</p><h2 id="trainer-<%= index %>"><%= item.name %></h2><p class="trainer-card__specialty"><%= item.specialty || 'Специализация пока не указана' %></p><a class="trainer-card__profile" href="<%= item.url %>" aria-label="<%= 'Профиль: '+item.name %>">Профиль тренера</a></div></article></li><% }); %></ul><% } %></section>
<div class="trainers__closing"><p>СИЛА НАЧИНАЕТСЯ<br><span>С ПЕРВОГО ШАГА.</span></p><a href="/#memberships">Смотреть абонементы</a></div></div></main><script src="/site/scripts/trainers.js" defer></script><%- include('footer') %>
