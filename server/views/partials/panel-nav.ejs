<%
  const navPath = typeof currentPath === 'string' ? (currentPath === '/trainer/workspace' ? '/trainer' : currentPath) : '';
  const navItems = ['OWNER','ADMIN'].includes(user.role) ? [
    ['/admin','Обзор',true], ['/crm/clients','Клиенты'], ['/crm/plans','Тарифы'],
    ['/crm/schedule','Расписание'], ['/crm/visits','Посещения'],
    ['/shop-panel/orders','Заказы магазина'], ['/shop-panel/products','Товары'],
    ['/admin/public-trainers','Публичные тренеры'], ['/admin/content','Контент сайта'], ['/admin/employees','Сотрудники'], ['/admin/account','Мой аккаунт'],
  ] : user.role === 'TRAINER' ? [
    ['/trainer','Обзор',true], ['/trainer/workspace/clients','Персональные клиенты'], ['/trainer/workspace/sessions','Персональные тренировки'], ['/trainer/workspace/expenses','Финансы'], ['/trainer/workspace/tasks','Задачи и напоминания'], ['/trainer/workspace/calendar','Календарь'], ['/trainer/workspace/statistics','Статистика'], ['/trainer/clients','Назначенные клиенты'],
    ['/trainer/lessons','Мои занятия'],
  ] : [ ['/crm/clients','Клиенты'], ['/crm/plans','Тарифы'],
    ['/crm/schedule','Расписание'], ['/crm/visits','Посещения'], ['/shop-panel/orders','Заказы магазина'] ];
  if (user.role === 'OWNER') navItems.splice(navItems.findIndex(item => item[0] === '/admin/employees'), 0, ['/admin/trainer-workspaces','Работа тренеров']);
  if (user.role === 'ADMIN') navItems.splice(navItems.findIndex(item => item[0] === '/admin/employees'), 1);
  navItems.push(['/application','Приложение'], ['/notifications','Уведомления'], ['/','Открыть сайт клуба',true]);

  const iconFor = url => url.includes('calendar') || url.includes('sessions') || url.includes('schedule') || url.includes('lessons') ? 'calendar-days' : url.includes('clients') || url.includes('employees') ? 'users-round' : url.includes('plans') ? 'tickets' : url.includes('visits') ? 'clipboard-check' : url.includes('orders') || url.includes('products') ? 'shopping-bag' : url.includes('notifications') ? 'bell' : url.includes('account') ? 'user-round' : url.includes('public-trainers') ? 'contact-round' : url.includes('content') ? 'panels-top-left' : url.includes('application') ? 'smartphone' : url === '/' ? 'external-link' : 'layout-dashboard';
  const dockUrls = user.role === 'TRAINER' ? ['/trainer','/trainer/clients','/trainer/lessons'] : ['OWNER','ADMIN'].includes(user.role) ? ['/admin','/crm/clients','/crm/schedule'] : ['/crm/clients','/crm/schedule','/shop-panel/orders'];
  const dockLabel = url => url === '/admin' || url === '/trainer' ? 'Обзор' : url.includes('clients') ? 'Клиенты' : url.includes('lessons') ? 'Занятия' : url.includes('orders') ? 'Заказы' : 'Расписание';
  const navSelected = (url,exact) => exact ? navPath === url : navPath === url || navPath.startsWith(url + '/');
  const overflowActive = navItems.some(([url,,exact]) => !dockUrls.includes(url) && navSelected(url,exact));
%>
<nav class="panel__nav" aria-label="Рабочие разделы">
  <% for (const [url,label,exact] of navItems) {
    const selected = exact ? navPath === url : navPath === url || navPath.startsWith(url + '/'); %>
    <a href="<%= url %>" <%- selected ? 'aria-current="page"' : '' %>><img class="app-nav__icon" src="/site/img/app/icons/<%= iconFor(url) %>.svg" alt="" width="22" height="22"><span><%= label %></span></a>
  <% } %>
</nav>

<nav class="app-dock" aria-label="Быстрая навигация">
  <% for(const url of dockUrls){ const item=navItems.find(i=>i[0]===url); %>
  <a class="app-dock__item" href="<%= url %>" <%- navSelected(url,item[2])?'aria-current="page"':'' %>><img src="/site/img/app/icons/<%= iconFor(url) %>.svg" alt="" width="23" height="23"><span><%= dockLabel(url) %></span></a>
  <% } %>
  <details class="app-dock__more">
    <summary class="app-dock__item" <%- overflowActive?'data-active="true"':'' %>><img src="/site/img/app/icons/ellipsis.svg" alt="" width="23" height="23"><span>Ещё</span></summary>
    <div class="app-dock__sheet"><p>Рабочие разделы</p><% for(const [url,label,exact] of navItems){ if(dockUrls.includes(url))continue; %><a href="<%= url %>" <%- navSelected(url,exact)?'aria-current="page"':'' %>><img src="/site/img/app/icons/<%= iconFor(url) %>.svg" alt="" width="22" height="22"><span><%= label %></span></a><% } %></div>
  </details>
</nav>
