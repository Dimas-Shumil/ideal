<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>ИДЕАЛ — клиенты и абонементы</title><link rel="stylesheet" href="/site/css/owner.css"><link rel="stylesheet" href="/site/css/crm.css"><script src="/site/scripts/owner.js" defer></script></head>
<body class="panel crm"><a class="panel__skip" href="#content">К содержимому</a>
<% const isTrainer=user.role==='TRAINER', isOwner=user.role==='OWNER', base=isTrainer?'/trainer/clients':'/crm/clients'; const methods={CASH:'Наличные',TRANSFER:'Перевод',CARD:'Карта'}; %>
<header class="panel__header"><a class="panel__brand" href="<%= isTrainer?'/trainer':isOwner?'/admin':'/crm/clients' %>">ИДЕАЛ<span><%= isTrainer?'Кабинет тренера':isOwner?'Панель владельца':'Панель администратора' %></span></a><span><%= user.displayName %></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Выйти</button></form></header>
<div class="panel__layout"><%- include('../partials/panel-nav') %>
<main class="panel__main" id="content">
<% if(page==='error'){ %><div class="panel__error" role="alert" tabindex="-1"><h1>Операция не выполнена</h1><p><%= error %></p></div><p>Вернитесь назад в браузере, чтобы исправить введённые данные, или откройте актуальную страницу.</p><a href="<%= back %>">Открыть актуальные данные</a>
<% }else if(page==='clients'){ %>
<div class="panel__heading"><h1><%= isTrainer?'Назначенные клиенты':'Клиенты' %></h1><% if(!isTrainer){ %><a class="panel__button" href="/crm/clients/new">Добавить клиента</a><% } %></div>
<% if(duplicate){ %><div class="panel__notice" role="status">Клиент сохранён. Такой телефон уже указан в другой карточке — проверьте, что это разные люди.</div><% } %>
<form class="crm__filters" method="get" action="<%= base %>"><label>ФИО или телефон<input type="search" name="q" maxlength="100" value="<%= filters.q %>"></label><% if(!isTrainer){ %><label>Состояние<select name="archived"><% for(const [v,l] of [['false','Активные'],['true','Архив'],['all','Все']]){ %><option value="<%= v %>" <%= filters.archived===v?'selected':'' %>><%= l %></option><% } %></select></label><% } %><button>Найти</button><a href="<%= base %>">Сбросить</a></form>
<p>Найдено: <%= total %>. Страница <%= filters.page %>.</p>
<div class="crm__grid"><% for(const c of items){ %><article class="panel__card"><h2><a href="<%= base %>/<%= c.id %>"><%= c.name %></a></h2><p><%= c.phone %> · Возраст: <%= c.age %></p><% if(c.archived){ %><span class="panel__badge">В архиве</span><% } %></article><% } %></div>
<% if(!items.length){ %><section class="panel__card"><h2>Клиентов не найдено</h2><p><%= isTrainer?'Отображаются только клиенты с действующим назначением вам.':'Измените поиск или добавьте клиента.' %></p></section><% } %>
<nav class="panel__pagination" aria-label="Страницы клиентов"><% const query=new URLSearchParams({q:filters.q,...(!isTrainer?{archived:filters.archived}:{})});if(filters.page>1){query.set('page',String(filters.page-1)); %><a href="<%= base %>?<%= query %>">Предыдущая</a><% }if(filters.page*25<total){query.set('page',String(filters.page+1)); %><a href="<%= base %>?<%= query %>">Следующая</a><% } %></nav>
<% }else if(page==='client-form'){ %>
<a href="/crm/clients">Все клиенты</a><h1><%= client?'Редактировать клиента':'Новый клиент' %></h1>
<form class="panel__card panel__form" method="post" action="<%= client?'/crm/clients/'+client.id+'/edit':'/crm/clients' %>"><%- include('meta',{version:client?.version}) %>
<label>ФИО<input name="name" required minlength="2" maxlength="150" autocomplete="name" value="<%= client?.name||'' %>"></label>
<label>Телефон<input name="phone" type="tel" required maxlength="30" autocomplete="tel" value="<%= client?.phone||'' %>"><small>Одинаковый телефон разрешён. При совпадении появится предупреждение.</small></label>
<label>Дата рождения<input name="birthDate" type="date" required min="1900-01-01" max="<%= today %>" value="<%= client?ds(client.birthDate):'' %>"><small>В этом этапе учитываются клиенты от 18 лет.</small></label>
<label>Комментарий<textarea name="comment" maxlength="1000" rows="4"><%= client?.comment||'' %></textarea><small>Доступен владельцу и администратору. Не указывайте медицинские сведения.</small></label><button>Сохранить клиента</button></form>
<% }else if(page==='client'){ %>
<a href="<%= base %>">Все клиенты</a><h1><%= client.name %></h1>
<% if(duplicate){ %><div class="panel__notice" role="status">Сохранено. Телефон совпадает с другой карточкой — проверьте возможный дубль.</div><% } %>
<section class="panel__card"><h2>Данные клиента</h2><p>Телефон: <a href="tel:+<%= client.phone %>">+<%= client.phone %></a></p><p>Возраст: <%= client.age %></p>
<% if(!isTrainer){ %><p>Дата рождения: <%= ds(client.birthDate) %></p><p>Состояние: <%= client.archived?'В архиве':'Активен' %></p><p class="crm__pre"><%= client.comment||'Комментарий не указан.' %></p><a href="/crm/clients/<%= client.id %>/edit">Редактировать данные</a><% } %></section>
<% if(!isTrainer){ %>
<section class="panel__card"><h2>Назначенные тренеры</h2><% if(!client.assignments.length){ %><p>Назначений нет.</p><% } %>
<% for(const a of client.assignments){const u=a.trainer.user; %><div class="crm__assignment"><p><%= u.displayName %><%= !u.active||u.role!=='TRAINER'?' — доступ сотрудника отключён':'' %></p><form class="panel__form" method="post" action="/crm/clients/<%= client.id %>/revoke"><%- include('meta',{version:client.version}) %><input type="hidden" name="assignmentId" value="<%= a.id %>"><label>Причина отзыва<input name="reason" required minlength="3" maxlength="500"></label><button>Отозвать назначение</button></form></div><% } %>
<% if(!client.archived && trainers.length){ %><form class="panel__form" method="post" action="/crm/clients/<%= client.id %>/assign"><%- include('meta',{version:client.version}) %><label>Тренер<select name="trainerId" required><option value="">Выберите тренера</option><% for(const t of trainers){ %><option value="<%= t.id %>"><%= t.displayName %></option><% } %></select></label><label>Причина назначения<input name="reason" required minlength="3" maxlength="500"></label><button>Назначить тренера</button></form><% } %></section>
<% } %>
<div class="panel__heading"><h2>Абонементы</h2><% if(!isTrainer && !client.archived){ %><a class="panel__button" href="/crm/clients/<%= client.id %>/issue">Оформить абонемент</a><% } %></div>
<p>Абонементов: <%= client.pagination.totalMemberships %>. Страница <%= client.pagination.membershipsPage %>. Даты и время — Абакан, UTC+7. Последний день включён.</p>
<% if(!client.memberships.length){ %><section class="panel__card"><p>Абонементов пока нет.</p></section><% } %>
<% for(const m of client.memberships){ %><%- include('membership',{m,isTrainer,isOwner,methods}) %><% } %>
<nav class="panel__pagination" aria-label="Страницы абонементов"><% const pq=new URLSearchParams({membershipsPage:String(client.pagination.membershipsPage),...(!isTrainer?{historyPage:String(client.pagination.historyPage)}:{})});if(client.pagination.membershipsPage>1){pq.set('membershipsPage',String(client.pagination.membershipsPage-1)); %><a href="<%= base %>/<%= client.id %>?<%= pq %>">Предыдущие абонементы</a><% }if(client.pagination.membershipsPage*25<client.pagination.totalMemberships){pq.set('membershipsPage',String(client.pagination.membershipsPage+1)); %><a href="<%= base %>/<%= client.id %>?<%= pq %>">Следующие абонементы</a><% } %></nav>
<% if(!isTrainer){ %>
<details class="panel__card"><summary><%= client.archived?'Восстановить клиента':'Архивировать клиента' %></summary><p>Архив не меняет срок абонемента и не выполняет возврат. Назначения тренерам отзываются и после восстановления не возвращаются автоматически.</p><form class="panel__form" method="post" action="/crm/clients/<%= client.id %>/archive"><%- include('meta',{version:client.version}) %><input type="hidden" name="archived" value="<%= client.archived?'false':'true' %>"><label>Причина<input name="reason" required minlength="3" maxlength="500"></label><button><%= client.archived?'Восстановить':'Архивировать' %></button></form></details>
<section class="panel__card"><h2>История изменений</h2><p>Событий: <%= client.pagination.totalEvents %>. Страница <%= client.pagination.historyPage %>. Все изменения сохраняются с автором и причиной.</p><% const names={CLIENT_CREATED:'Клиент создан',CLIENT_UPDATED:'Данные изменены',CLIENT_ARCHIVE:'Архив изменён',CLIENT_ASSIGN:'Тренер назначен',CLIENT_REVOKE:'Назначение отозвано',MEMBERSHIP_ISSUED:'Абонемент оформлен',MEMBERSHIP_CANCEL:'Абонемент отменён',MEMBERSHIP_EXTEND:'Абонемент продлён',MEMBERSHIP_ADJUST:'Остаток скорректирован',MEMBERSHIP_FREEZE:'Абонемент заморожен',MEMBERSHIP_THAW:'Заморозка завершена',MEMBERSHIP_REFUND:'Возврат проведён'}; %>
<% for(const e of client.events){ %><article class="crm__event"><h3><%= names[e.action]||e.action %></h3><p><%= e.createdAt.toLocaleString('ru-RU',{timeZone:'Asia/Krasnoyarsk'}) %> · <%= e.actor?.displayName||'Сотрудник удалён' %></p><% if(e.reason){ %><p class="crm__pre"><%= e.reason %></p><% } %><%- include('event',{event:e,methods}) %></article><% } %><nav class="panel__pagination" aria-label="Страницы истории"><% const hq=new URLSearchParams({membershipsPage:String(client.pagination.membershipsPage)});if(client.pagination.historyPage>1){hq.set('historyPage',String(client.pagination.historyPage-1)); %><a href="/crm/clients/<%= client.id %>?<%= hq %>">Предыдущие события</a><% }if(client.pagination.historyPage*25<client.pagination.totalEvents){hq.set('historyPage',String(client.pagination.historyPage+1)); %><a href="/crm/clients/<%= client.id %>?<%= hq %>">Следующие события</a><% } %></nav></section>
<% } %>
<% }else if(page==='plans'){ %>
<div class="panel__heading"><h1>Тарифы</h1><% if(isOwner){ %><a class="panel__button" href="/crm/plans/new">Добавить тариф</a><% } %></div><p>Условия оформленных абонементов сохраняются при изменении тарифа. Прайс вносится по подтверждённым данным клуба.</p>
<% if(!plans.length){ %><section class="panel__card"><h2>Тарифы ещё не добавлены</h2><p>Владелец может внести действующий прайс клуба.</p></section><% } %>
<div class="crm__grid"><% for(const p of plans){ %><article class="panel__card"><h2><%= p.name %></h2><p><%= money(p.priceCents) %> ₽<%= p.duo?' за человека · Дуэт':'' %></p><p><%= p.kind==='GYM'?'Тренажёрный зал':'Групповые занятия' %> · <%= p.active?'Доступен':'Отключён' %></p><%- include('conditions',{p}) %><% if(isOwner){ %><a href="/crm/plans/<%= p.id %>">Редактировать тариф</a><% } %></article><% } %></div>
<% }else if(page==='plan-form'){ %><%- include('plan-form',{plan}) %>
<% }else if(page==='issue'){ %><%- include('issue',{client,plans,plan,partners,partnerQ,methods}) %>
<% } %><p class="panel__busy" role="status" aria-live="polite"></p></main></div></body></html>
