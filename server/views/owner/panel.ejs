<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>ИДЕАЛ — панель владельца</title><link rel="stylesheet" href="/site/css/owner.css"><script src="/site/scripts/owner.js" defer></script></head>
<body class="panel"><a class="panel__skip" href="#content">К содержимому</a>
<header class="panel__header"><a class="panel__brand" href="/admin">ИДЕАЛ<span>Панель владельца</span></a><span><%= user.displayName %></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="panel__secondary">Выйти</button></form></header>
<div class="panel__layout"><nav class="panel__nav" aria-label="Панель владельца"><a href="/admin" <%- page === 'overview' ? 'aria-current="page"' : '' %>>Обзор</a><a href="/crm/clients">Клиенты</a><a href="/crm/plans">Тарифы</a><a href="/admin/employees" <%- ['employees','edit','create'].includes(page) ? 'aria-current="page"' : '' %>>Сотрудники</a><a href="/admin/account" <%- page === 'account' ? 'aria-current="page"' : '' %>>Мой аккаунт</a><a href="/">Открыть сайт клуба</a></nav>
<main id="content" class="panel__main"><% if(error) { %><div class="panel__error" role="alert" tabindex="-1"><%= error %></div><% } %>
<% const names = {OWNER:'Владелец',ADMIN:'Администратор',TRAINER:'Тренер'}; %>
<% if(page === 'overview') { %>
<p class="panel__eyebrow">Один клуб. Единое управление.</p><h1>Обзор</h1><p>Данные учётных записей клуба на момент открытия страницы.</p>
<div class="panel__metrics"><section class="panel__card"><h2>Учётные записи</h2><strong><%= total %></strong></section><section class="panel__card"><h2>Активные</h2><strong><%= active %></strong></section><section class="panel__card"><h2>Активные владельцы</h2><strong><%= owners %></strong></section></div>
<section class="panel__card"><h2>Доступ и сотрудники</h2><p>Создание аккаунтов, изменение прав и активности, безопасная смена своего пароля.</p><a class="panel__button" href="/admin/employees">Управлять сотрудниками</a></section>
<section class="panel__card"><h2>Следующие модули</h2><p>Кабинет тренера доступен сотрудникам с ролью TRAINER. Клиенты и абонементы доступны в разделе «Клиенты». Расписание и управление магазином ещё не подключены.</p></section>
<% } else if(page === 'employees') { %>
<div class="panel__heading"><h1>Сотрудники</h1><a class="panel__button" href="/admin/employees/new">Создать аккаунт</a></div>
<form class="panel__filters" method="get" action="/admin/employees"><label>Поиск по имени или логину<input type="search" name="q" maxlength="100" value="<%= filters.q %>"></label><label>Роль<select name="role"><option value="">Все роли</option><% for(const role of Object.keys(names)) { %><option value="<%= role %>" <%= filters.role === role ? 'selected' : '' %>><%= names[role] %></option><% } %></select></label><label>Активность<select name="active"><option value="">Все</option><option value="true" <%= filters.active === 'true' ? 'selected' : '' %>>Активные</option><option value="false" <%= filters.active === 'false' ? 'selected' : '' %>>Отключённые</option></select></label><button>Найти</button><a href="/admin/employees">Сбросить</a></form>
<p>Найдено: <%= total %>. Страница <%= filters.page %>.</p><div class="panel__employees"><% for(const employee of items) { %><article class="panel__card"><div class="panel__heading"><h2><%= employee.displayName %></h2><span class="panel__badge"><%= employee.active ? 'Активен' : 'Отключён' %></span></div><p><%= employee.login %> · <%= names[employee.role] %><%= employee.id === user.id ? ' · Это вы' : '' %></p><a href="/admin/employees/<%= employee.id %>">Управление аккаунтом</a></article><% } %></div>
<% if(!items.length) { %><section class="panel__card"><h2>Никого не найдено</h2><p>Измените условия поиска или создайте аккаунт.</p></section><% } %>
<nav class="panel__pagination" aria-label="Страницы сотрудников"><% const query = new URLSearchParams({q:filters.q,role:filters.role,active:filters.active}); if(filters.page > 1) { query.set('page',String(filters.page-1)); %><a href="/admin/employees?<%= query %>">Предыдущая</a><% } if(filters.page*25 < total) { query.set('page',String(filters.page+1)); %><a href="/admin/employees?<%= query %>">Следующая</a><% } %></nav>
<% } else if(page === 'create') { %>
<a href="/admin/employees">Все сотрудники</a><h1>Создать аккаунт</h1><p>Роли взаимоисключающие. Владелец управляет доступом и не совмещает роль тренера.</p>
<form class="panel__card panel__form" method="post" action="/admin/employees"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Логин<input name="login" required minlength="3" maxlength="64" pattern="[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}" autocomplete="off" value="<%= values.login || '' %>"><small>3–64 латинских символа, цифры, точка, дефис, подчёркивание.</small></label><label>Отображаемое имя<input name="displayName" required maxlength="100" value="<%= values.displayName || '' %>"></label><label>Роль<select name="role"><option value="TRAINER">Тренер</option><option value="ADMIN">Администратор</option><option value="OWNER">Владелец — полный доступ</option></select></label><label>Пароль нового сотрудника<input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="128"><small>12–128 символов, до 256 байт. Забытый пароль восстанавливает оператор ShumDev.</small></label><%- include('confirm') %><button>Создать аккаунт</button></form>
<% } else if(page === 'edit') { %>
<a href="/admin/employees">Все сотрудники</a><h1><%= employee.displayName %></h1><p><%= employee.login %> · <%= names[employee.role] %> · <%= employee.active ? 'Активен' : 'Отключён' %></p>
<% if(employee.id === user.id) { %><p class="panel__notice">Это ваш аккаунт. Смена роли или отключение завершит ваш доступ к панели. Последнего активного владельца изменить таким образом нельзя.</p><% } %>
<form class="panel__card panel__form" method="post" action="/admin/employees/<%= employee.id %>/name"><h2>Отображаемое имя</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Новое имя<input name="displayName" required maxlength="100" value="<%= employee.displayName %>"></label><p>Изменение имени не завершает сессии.</p><%- include('confirm') %><button>Сохранить имя</button></form>
<form class="panel__card panel__form" method="post" action="/admin/employees/<%= employee.id %>/role"><h2>Изменить права</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Новая роль<select name="role"><% for(const role of Object.keys(names)) { %><option value="<%= role %>" <%= employee.role === role ? 'selected' : '' %>><%= names[role] %></option><% } %></select></label><p>OWNER получает полный доступ. Все сессии этого сотрудника будут завершены.</p><%- include('confirm') %><button>Подтвердить изменение роли</button></form>
<form class="panel__card panel__form" method="post" action="/admin/employees/<%= employee.id %>/active"><h2><%= employee.active ? 'Отключить аккаунт' : 'Активировать аккаунт' %></h2><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= employee.active ? 'false' : 'true' %>"><p>Отключённый сотрудник не может войти. История аккаунта сохраняется. Все его сессии будут завершены.</p><%- include('confirm') %><button><%= employee.active ? 'Подтвердить отключение' : 'Подтвердить активацию' %></button></form>
<% } else if(page === 'account') { %>
<h1>Мой аккаунт</h1><section class="panel__card"><h2><%= user.displayName %></h2><p>Логин: <%= user.login %></p><p>Роль: владелец</p></section>
<form class="panel__card panel__form" method="post" action="/admin/account/password"><h2>Сменить пароль</h2><p>Все ваши сессии будут завершены. После сохранения войдите заново.</p><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Текущий пароль<input name="currentPassword" type="password" required maxlength="128" autocomplete="current-password"></label><label>Новый пароль<input name="newPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password"><small>12–128 символов, до 256 байт.</small></label><button>Сменить пароль и выйти</button></form><p>Забытый пароль восстанавливается через CLI оператора ShumDev.</p>
<% } %>
<p class="panel__busy" role="status" aria-live="polite"></p></main></div></body></html>
